DATABASE_URL="postgresql://user:password@localhost:5432/vifatube?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 32-byte key (base64) used for AES-256-GCM encryption of secrets at rest.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=""

ANTHROPIC_API_KEY=""
# Optional override — defaults to a current Claude Sonnet model if unset.
ANTHROPIC_MODEL=""
HIGGSFIELD_API_KEY_ID=""
HIGGSFIELD_API_KEY_SECRET=""
# Optional override if Higgsfield's API base URL differs from the default.
HIGGSFIELD_API_BASE_URL=""
# Optional override — defaults to "higgsfield-ai/soul/standard", one of only
# two publicly documented REST API model_ids (the other is
# "reve/text-to-image"). Consumer-app model slugs (e.g. "flux_2") are NOT
# valid here — they belong to a separate consumer/MCP subscription pool, not
# the pay-as-you-go Developer API credit pool this app's server calls draw
# from. See docs/superpowers/ops/env-setup.md for details.
HIGGSFIELD_MODEL_ID=""
